{
  "expo": {
    "name": "English Comeback",
    "slug": "english-comeback",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.janailsonfa.englishcomeback"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0E13",
        "foregroundImage": "./assets/brand-adaptive-icon.png",
        "monochromeImage": "./assets/brand-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.janailsonfa.englishcomeback",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/brand-favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow English Comeback to record Speaking Missions and Time Capsules locally on this device.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "scheme": "english-comeback",
    "backgroundColor": "#0B0E13",
    "experiments": {
      "typedRoutes": true
    },
    "owner": "janailsonf-a",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "555cde6f-8d6e-436b-8712-16025e24f1ff"
      }
    }
  }
}
